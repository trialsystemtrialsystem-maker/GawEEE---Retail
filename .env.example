# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase — from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payment Gateways (sandbox until Sprint 4 real integration — see todo.md)
DOKU_MERCHANT_ID=
DOKU_SECRET_KEY=
DOKU_API_URL=https://api-sandbox.doku.com

BANK_VA_API_KEY=
BANK_VA_SECRET=

# Email (Supabase Auth's built-in SMTP, or point it at SendGrid in the
# Supabase dashboard under Authentication > Email Templates > SMTP Settings)
SENDGRID_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Monitoring (optional, Phase 1 polish)
SENTRY_DSN=
